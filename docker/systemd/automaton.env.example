# /etc/automaton/automaton.env (fork, VPS). Read by the systemd units. No secret
# values here: only where the secrets are and the owner's public address.
#   sudo install -d -m 755 /etc/automaton
#   sudo install -m 644 docker/systemd/automaton.env.example /etc/automaton/automaton.env   (then edit)

# Folder with one file per secret (openai_api_key, wallet_passphrase, ...), outside the repo.
# On Linux the runtime (uid/gid 10001) must read it, the login user need not:
#   sudo install -d -o root -g 10001 -m 750 /etc/automaton/secrets
#   sudo install -o root -g 10001 -m 640 /dev/null /etc/automaton/secrets/openai_api_key   (then write the key with sudoedit)
# The runtime refuses to start (exit 78) when a secret file exists but is not readable.
AUTOMATON_SECRETS_DIR=/etc/automaton/secrets

# The owner's own wallet (public address; payments may only go here).
AUTOMATON_CREATOR_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: where logs, the stop marker and the supervisor state go (default ~/.automaton-logs).
# AUTOMATON_LOG_DIR=/home/automaton/.automaton-logs

# --- /etc/automaton/watch.env (separate file, only for a watched run) ---
# AUTOMATON_WATCH_SINCE=2026-12-01T12:00:00Z
# AUTOMATON_WATCH_UNTIL=2026-12-04T12:00:00Z
# AUTOMATON_WATCH_MAX_RUN_CENTS=20
